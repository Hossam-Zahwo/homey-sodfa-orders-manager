# Orders Manager on Vercel, NOT the original HOMEY website.
# Create a NEW independent Supabase project first.
# Public Supabase values: safe for the browser. Copy from new project > Connect > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Private server-only secret, NEVER prefix with NEXT_PUBLIC_:
SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_PROJECT_SERVICE_ROLE_SECRET
# Both exact verified emails; user can log in only if email is here:
ALLOWED_EMAILS=first-person@example.com,second-person@example.com
# Supabase Authentication -> Email must be enabled. Site URL/redirect URLs set to your Vercel domain.
# Do not set NEXT_PUBLIC_DEMO_MODE=true if you want real orders.
