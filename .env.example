# Independent HOMEY & SODFA Orders Manager on Vercel.
# This is NOT the HOMEY storefront or its Supabase projects.
# Server-only pooled Neon PostgreSQL URL. Never commit a real value.
DATABASE_URL=postgresql://role:password@host-pooler.region.aws.neon.tech/orders_manager?sslmode=require
# Neon Auth managed Better Auth endpoint (server only).
NEON_AUTH_BASE_URL=https://your-instance.neonauth.region.aws.neon.tech/orders_manager/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-48
# Strictly the two explicitly authorized email addresses:
ALLOWED_EMAILS=first-person@example.com,second-person@example.com
